# Copy this file to .env and fill in real values:  cp .env.example .env
# .env is git-ignored. Never commit real secrets, and never paste a real
# generated secret back into this example file.

PORT=3000
MONGODB_URI=mongodb://localhost:27017/task-manager

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------

# REQUIRED. Used to sign and verify JWTs. The server refuses to start without
# it, and there is deliberately no fallback value — a hardcoded development
# secret is the most common way a project ships forgeable tokens.
#
# Must be at least 32 characters. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=replace-me-with-a-random-string-of-at-least-32-characters

# Optional. How long an issued login token stays valid (default: 1h).
# Any value the `jsonwebtoken` library understands, e.g. 15m, 1h, 7d.
# There are no refresh tokens, so this is the only expiry that exists.
JWT_EXPIRES_IN=1h

# ---------------------------------------------------------------------------
# CORS (Phase 6)
# ---------------------------------------------------------------------------

# Browser origins permitted to read responses from this API, comma-separated.
# Whitespace is trimmed and empty entries ignored, so a trailing comma is safe.
#
# If unset or empty, NO browser origin is allowed — the failure mode is "deny",
# never "allow everything". There is no wildcard default on purpose.
#
# Requests with no Origin header (curl, Postman, server-to-server) are always
# allowed: CORS is a browser mechanism and cannot gate non-browser clients.
# Those callers are gated by the JWT instead.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------------------------------------------------------------------------
# Rate limiting (Phase 6)
# ---------------------------------------------------------------------------

# General limiter, applied to all /api traffic.
# Defaults: 15 minutes / 300 requests. Invalid values stop the server rather
# than silently disabling the limiter.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Stricter limiter for POST /api/auth/login and POST /api/auth/register.
# Defaults: 15 minutes / 10 requests.
#   login    - only FAILED attempts count, so a legitimate user cannot lock
#              themselves out by signing in repeatedly.
#   register - every request counts, because successful mass account creation
#              is itself the abuse.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# NOTE: counters are held in memory. That is fine for one process, but with
# several instances behind a load balancer each keeps its own counts, so the
# effective limit becomes (instances x max). A shared store is out of scope.

# ---------------------------------------------------------------------------
# Request body size (Phase 6)
# ---------------------------------------------------------------------------

# Maximum accepted JSON body. Accepts 16kb, 1mb, 512b or a plain byte count.
# Default: 16kb. A valid task is well under 2kb, so this is generous while
# still refusing a multi-megabyte payload. Oversized requests get 413.
JSON_BODY_LIMIT=16kb
